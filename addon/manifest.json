{
  "manifest_version": 2,
  "name": "本地 MDX 点击查词",
  "version": "1.0.0",
  "description": "在 Zotero PDF 阅读器中点击或划选单词、词组查本地 MDX；查询连字符和断行拼接写法，读取配套 MDD 分卷的样式、图片、字体和音频。",
  "author": "Noahxie83",
  "applications": {
    "zotero": {
      "id": "local-mdx-click@noahx.local",
      "update_url": "https://raw.githubusercontent.com/Noahxie83/zotero-local-mdx-click/main/updates.json",
      "strict_min_version": "10.0",
      "strict_max_version": "10.0.*"
    }
  }
}
